{
  "name": "tennis-ai-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "codespace",
  "remoteEnv": {
    "FLUTTER_HOME": "/opt/flutter",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "PATH": "/home/codespace/.local/bin:/usr/lib/jvm/java-17-openjdk-amd64/bin:/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${containerEnv:PATH}"
  },
  "forwardPorts": [
    3000,
    8000,
    5432
  ],
  "portsAttributes": {
    "3000": {
      "label": "Flutter Web"
    },
    "8000": {
      "label": "FastAPI"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/setup-codex-persistence.sh && bash .devcontainer/scripts/setup-development.sh",
  "postStartCommand": "bash .devcontainer/scripts/start-services.sh"
}

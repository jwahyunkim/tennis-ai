POSTGRES_DB=tennis_ai
POSTGRES_USER=tennis_ai
# The development setup script generates a local password in infra/.env.
# Set your own non-empty password when configuring this file manually.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Docker Compose publishes the API on localhost; use an HTTPS reverse proxy publicly.
API_PORT=8000
AUTH_SESSION_HOURS=24
MAX_UPLOAD_BYTES=262144000
MAX_VIDEO_SECONDS=120
MAX_USER_STORAGE_BYTES=2147483648

# Local development defaults outside the repository; Compose uses /data/media.
STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=/absolute/private/path/to/media

# Optional external object storage. Inject AWS credentials via your secret manager.
# STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# S3_REGION=your-region
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
